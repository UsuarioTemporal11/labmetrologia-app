{
  "expo": {
    "name": "Lab Metrología",
    "slug": "labmetrologia-app",
    "version": "1.0.0",
    "owner": "alvaroac26",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false
    },
    "android": {
      "package": "com.alvaroac.labmetrologia",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN"
      ]
    },
    "splash": {
      "backgroundColor": "#1a3a52"
    },
    "extra": {
      "eas": {
        "projectId": "369e8bff-a0ff-45f1-a312-69ef17117549"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "minSdkVersion": 23,
            "kotlinVersion": "1.9.24"
          }
        }
      ]
    ]
  }
}
